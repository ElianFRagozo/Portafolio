---
import RocketEffect from './RocketEffect.tsx';
---

<section id="services" class="py-20 px-4 sm:px-6 lg:px-8 relative">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <p class="font-mono text-accent-400 text-sm tracking-[0.3em] uppercase mb-3">
        Lo que puedo construir para ti
      </p>
      <h2 class="text-4xl sm:text-5xl font-bold mb-4">
        Mis <span class="text-gradient">Servicios</span>
      </h2>
      <p class="text-gray-400 text-lg max-w-2xl mx-auto">
        Soluciones a la medida para negocios y emprendedores que quieren llevar su operación al siguiente nivel.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">

      <!-- Sitios Web y Aplicaciones -->
      <RocketEffect effectType="glow">
        <div class="group h-full bg-slate-800/40 backdrop-blur-sm border border-white/10 rounded-2xl p-8 hover:border-cyan-400/50 transition-all duration-500 hover:scale-105 hover:shadow-2xl hover:shadow-cyan-500/10">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-cyan-400/25 to-cyan-400/5 border border-cyan-400/30 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300" style="box-shadow: 0 0 30px rgba(0, 229, 255, 0.25);">
            <svg class="w-8 h-8 text-cyan-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <rect x="2" y="3" width="20" height="14" rx="2"/>
              <line x1="8" y1="21" x2="16" y2="21" stroke-linecap="round"/>
              <line x1="12" y1="17" x2="12" y2="21" stroke-linecap="round"/>
              <line x1="2" y1="8" x2="22" y2="8"/>
            </svg>
          </div>

          <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-cyan-400 transition-colors">
            Sitios Web y Aplicaciones
          </h3>

          <p class="text-gray-400 leading-relaxed mb-6">
            Páginas profesionales, tiendas en línea y aplicaciones personalizadas que reflejan la identidad de tu negocio y convierten visitantes en clientes.
          </p>

          <ul class="space-y-2 text-sm text-gray-300">
            <li class="flex items-start gap-2">
              <span class="text-cyan-400 mt-1">→</span>
              <span>Páginas web corporativas y landings</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-cyan-400 mt-1">→</span>
              <span>Tiendas en línea y e-commerce</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-cyan-400 mt-1">→</span>
              <span>Aplicaciones web a la medida</span>
            </li>
          </ul>
        </div>
      </RocketEffect>

      <!-- Sistemas de Gestión -->
      <RocketEffect effectType="glow">
        <div class="group h-full bg-slate-800/40 backdrop-blur-sm border border-white/10 rounded-2xl p-8 hover:border-green-400/50 transition-all duration-500 hover:scale-105 hover:shadow-2xl hover:shadow-green-500/10">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-green-400/25 to-green-400/5 border border-green-400/30 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300" style="box-shadow: 0 0 30px rgba(0, 255, 136, 0.25);">
            <svg class="w-8 h-8 text-green-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <ellipse cx="12" cy="5" rx="9" ry="3"/>
              <path d="M3 5v6c0 1.66 4.03 3 9 3s9-1.34 9-3V5"/>
              <path d="M3 11v6c0 1.66 4.03 3 9 3s9-1.34 9-3v-6"/>
            </svg>
          </div>

          <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-green-400 transition-colors">
            Sistemas de Gestión
          </h3>

          <p class="text-gray-400 leading-relaxed mb-6">
            Organiza clientes, ventas, inventario o procesos internos en un solo lugar. Software seguro, rápido y diseñado para tu operación.
          </p>

          <ul class="space-y-2 text-sm text-gray-300">
            <li class="flex items-start gap-2">
              <span class="text-green-400 mt-1">→</span>
              <span>CRM para clientes y ventas</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-green-400 mt-1">→</span>
              <span>Control de inventario y bodega</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-green-400 mt-1">→</span>
              <span>Automatización de procesos</span>
            </li>
          </ul>
        </div>
      </RocketEffect>

      <!-- Reportes y Tableros Visuales -->
      <RocketEffect effectType="glow">
        <div class="group h-full bg-slate-800/40 backdrop-blur-sm border border-white/10 rounded-2xl p-8 hover:border-fuchsia-400/50 transition-all duration-500 hover:scale-105 hover:shadow-2xl hover:shadow-fuchsia-500/10">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-fuchsia-400/25 to-fuchsia-400/5 border border-fuchsia-400/30 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300" style="box-shadow: 0 0 30px rgba(255, 100, 255, 0.25);">
            <svg class="w-8 h-8 text-fuchsia-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <line x1="3" y1="20" x2="21" y2="20" stroke-linecap="round"/>
              <rect x="5" y="11" width="3" height="9"/>
              <rect x="10.5" y="6" width="3" height="14"/>
              <rect x="16" y="14" width="3" height="6"/>
            </svg>
          </div>

          <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-fuchsia-400 transition-colors">
            Reportes y Tableros Visuales
          </h3>

          <p class="text-gray-400 leading-relaxed mb-6">
            Convierto los datos de tu negocio en gráficos claros y dashboards en tiempo real para que tomes mejores decisiones cada día.
          </p>

          <ul class="space-y-2 text-sm text-gray-300">
            <li class="flex items-start gap-2">
              <span class="text-fuchsia-400 mt-1">→</span>
              <span>Dashboards interactivos en Power BI</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-fuchsia-400 mt-1">→</span>
              <span>Reportes automáticos por correo</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-fuchsia-400 mt-1">→</span>
              <span>Análisis de ventas y KPIs</span>
            </li>
          </ul>
        </div>
      </RocketEffect>

    </div>

    <!-- CTA -->
    <div class="text-center mt-14">
      <p class="text-gray-400 mb-4">¿Tienes una idea o problema en mente?</p>
      <a
        href="#contact"
        class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-primary-500 to-accent-500 rounded-full font-semibold text-white hover:scale-105 transition-all duration-300 shadow-lg hover:shadow-xl"
      >
        <span>Hablemos de tu proyecto</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>
