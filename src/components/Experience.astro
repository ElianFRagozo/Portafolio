---
const experiences = [
  {
    role: 'Desarrollador Full Stack Freelance',
    company: 'Unabase',
    location: 'Chile (Remoto)',
    period: 'Mar. 2025 – Actualidad',
    current: true,
    bullets: [
      'Desarrollo y mantenimiento de sistemas web con JavaScript, jQuery, Vue.js, Node.js y Chart.js.',
      'Optimización de aplicaciones web robustas y escalables integrando bases de datos SQL, MongoDB y 4D.',
      'Implementación de visualizaciones interactivas con Chart.js para reportes y dashboards de negocio.'
    ],
    highlight: null
  },
  {
    role: 'Desarrollador Full Stack',
    company: 'Palm IT',
    location: 'Colombia (Remoto)',
    period: 'Nov. 2025 – Ene. 2026',
    current: false,
    bullets: [
      'Diseño y desarrollo de aplicaciones bajo arquitectura de microservicios con Java Spring Boot y Angular.',
      'Implementación y consumo de APIs REST documentadas con Swagger sobre PostgreSQL.',
      'Gestión de contenedores con Docker y despliegue en entornos DEV y QA sobre Azure.',
      'Trabajo bajo metodología Scrum: ceremonias ágiles, historias de usuario y resolución de bugs.'
    ],
    highlight: {
      title: 'Stack destacado:',
      text: 'Java Spring Boot · Angular · PostgreSQL · Docker · Azure · Swagger'
    }
  },
  {
    role: 'QA Tester',
    company: 'Velocity Go',
    location: 'Colombia (Remoto)',
    period: 'Mar. 2025 – Sept. 2025',
    current: false,
    bullets: [
      'Diseño, ejecución y documentación de casos de prueba manuales para aplicaciones web y móviles.',
      'Pruebas funcionales, de regresión, smoke y exploratorias asegurando la calidad de cada entrega.',
      'Reporte y gestión de defectos en Jira con pasos de reproducción y evidencias.',
      'Colaboración con el equipo de desarrollo para corrección de errores y verificación de fixes.'
    ],
    highlight: null
  },
  {
    role: 'Desarrollador Backend',
    company: 'Creador de Soluciones Tecnológicas',
    location: 'Valledupar, Colombia',
    period: 'Ene. 2023 – Ene. 2025',
    current: false,
    bullets: [
      'Implementación de servicios backend en Go y .NET Core para soluciones de alto rendimiento.',
      'Optimización de bases de datos SQL Server y PostgreSQL con reestructuración de índices.',
      'Automatización de tareas operativas con PowerShell para mejorar tiempos de procesos batch.',
      'Aseguramiento de integridad y disponibilidad de la información con políticas de respaldo.'
    ],
    highlight: {
      title: 'Logro destacado:',
      text: 'Reduje hasta un 40% los tiempos de consultas críticas en producción mediante optimización de índices y reescritura de queries pesadas.'
    }
  },
  {
    role: 'Analista de Datos (Pasantía)',
    company: 'Fonvisocial',
    location: 'Valledupar, Colombia',
    period: 'Ago. 2024 – Dic. 2024',
    current: false,
    bullets: [
      'Consolidación y optimización de bases de datos en SQL para reportería ejecutiva.',
      'Desarrollo de reportes interactivos en Power BI para la alta gerencia.',
      'Automatización de procesos de monitoreo y seguimiento de información técnica.'
    ],
    highlight: {
      title: 'Logro destacado:',
      text: 'Mejoré en más de un 30% el procesamiento de datos consolidando bases dispersas y diseñando dashboards en Power BI que apoyaron decisiones estratégicas de la dirección.'
    }
  },
  {
    role: 'Desarrollador Backend Junior',
    company: 'TechSoluciones S.A.S',
    location: 'Medellín (Remoto)',
    period: 'Ene. 2022 – Jun. 2022',
    current: false,
    bullets: [
      'Diseño e implementación de arquitecturas de integración con microservicios.',
      'Gestión de Azure Service Bus y Event Grid para flujos de datos distribuidos.',
      'Optimización de comunicación entre aplicaciones distribuidas en alta demanda.'
    ],
    highlight: {
      title: 'Logro destacado:',
      text: 'Generé estrategias para implementar flujos automáticos de escalación de casos y resolución de incidentes, reduciendo los tiempos de respuesta en más de un 25%.'
    }
