];
---

<section id="experience" class="py-20 px-4 sm:px-6 lg:px-8">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <p class="font-mono text-accent-400 text-sm tracking-[0.3em] uppercase mb-3">
        Trayectoria
      </p>
      <h2 class="text-4xl sm:text-5xl font-bold mb-4">
        Mi <span class="text-gradient">Experiencia</span>
      </h2>
      <p class="text-gray-400 text-lg max-w-2xl mx-auto">
        Mi trayectoria profesional construyendo software backend, full stack y soluciones de datos.
      </p>
    </div>

    <div class="relative">
      <!-- Timeline line -->
      <div class="absolute left-4 md:left-1/2 transform md:-translate-x-0.5 top-0 bottom-0 w-0.5 bg-gradient-to-b from-primary-500 via-accent-500 to-primary-500"></div>

      <div class="space-y-12">
        {experiences.map((exp, index) => {
          const isLeft = index % 2 === 0;
          const dotColor = isLeft ? 'bg-primary-500' : 'bg-accent-500';
          return (
            <div class="relative flex items-center">
              {/* Dot on timeline */}
              <div class={`absolute left-4 md:left-1/2 transform -translate-x-1/2 w-4 h-4 ${dotColor} rounded-full border-4 border-slate-900 z-10`}>
                {exp.current && (
                  <span class="absolute inset-0 rounded-full bg-green-400 animate-ping opacity-75"></span>
                )}
              </div>

              <div class={`ml-12 md:ml-0 md:w-1/2 ${isLeft ? 'md:pr-8' : 'md:pl-8 md:ml-auto'}`}>
                <div class="bg-slate-800/50 backdrop-blur-sm border border-white/10 rounded-xl p-6 hover:border-accent-500/50 transition-all duration-300 hover:scale-[1.02] hover:shadow-xl">
                  <div class="flex flex-wrap items-start justify-between gap-2 mb-2">
                    <h3 class="text-xl font-semibold text-gradient">{exp.role}</h3>
                    <span class="text-sm text-accent-400 font-mono whitespace-nowrap">
                      {exp.period}
                    </span>
                  </div>

                  <p class="text-accent-400 font-medium mb-1">
                    {exp.company}
                    {exp.current && (
                      <span class="ml-2 inline-flex items-center gap-1.5 px-2 py-0.5 text-xs rounded-full bg-green-400/15 text-green-400 border border-green-400/30 align-middle">
                        <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse"></span>
                        Activo
                      </span>
                    )}
                  </p>
                  <p class="text-xs text-gray-500 mb-3">{exp.location}</p>

                  <ul class="text-gray-400 space-y-2 text-sm">
                    {exp.bullets.map((bullet) => (
                      <li class="flex gap-2">
                        <span class="text-accent-400 mt-0.5">•</span>
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>

                  {exp.highlight && (
                    <div class="mt-4 p-3 bg-accent-500/10 border border-accent-500/20 rounded-lg">
                      <p class="text-accent-400 text-sm font-semibold mb-1">{exp.highlight.title}</p>
                      <p class="text-gray-300 text-sm leading-relaxed">{exp.highlight.text}</p>
                    </div>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
